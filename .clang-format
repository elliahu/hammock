BasedOnStyle: Google
IndentWidth: 4
ColumnLimit: 110
NamespaceIndentation: All
BinPackArguments: false
ContinuationIndentWidth: 4
AlignAfterOpenBracket: DontAlign
Cpp11BracedListStyle: false
SpaceBeforeParens: ControlStatements
BraceWrapping:
  AfterFunction: true
  AfterClass: true
  AfterStruct: true
  IndentBraces: false
