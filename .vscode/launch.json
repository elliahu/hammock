{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug target (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "${env:PATH};${command:cmake.getLaunchTargetDirectory}"
        }
      ],
      "console": "integratedTerminal"
    }
  ]
}
